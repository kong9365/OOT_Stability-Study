# 데이터 연동: Databricks `광동제약_gmp_lims` (서비스 계정 OAuth M2M, databricks_client.py)
# 서비스 계정이 이 PC의 ~/.databrickscfg [lims-sp] 프로필에 있으면 아래는 비워 둬도 된다.
# DATABRICKS_HOST=https://dbc-6430e2d7-1523.cloud.databricks.com
# DATABRICKS_WAREHOUSE_ID=ec6e1860e1e62aff
# DATABRICKS_CLIENT_ID=여기에_서비스계정_client_id_입력
# DATABRICKS_CLIENT_SECRET=여기에_서비스계정_client_secret_입력

# (선택) 이 API에 접근할 때 요구할 API Key
# 설정하면 요청 헤더 X-API-Key 또는 쿼리 파라미터 api_key 로 검증합니다.
# 비워두면 인증 없이 누구나 호출 가능합니다.
API_KEY=

# 서버 포트 (기본: 8000)
PORT=8000
