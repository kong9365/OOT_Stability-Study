# 광동 품질·시험 통합 대시보드 — 설정 템플릿
# 이 파일을 복사해 ".env" 로 저장하고 값을 채우세요.
#   (Windows) copy .env.example .env

# [Tableau 연결] 사내망에서 접근 가능해야 함
TABLEAU_SERVER=http://your-tableau-server
TABLEAU_API_VERSION=3.21
TABLEAU_PAT_NAME=YOUR_PAT_NAME
TABLEAU_PAT_SECRET=YOUR_PAT_SECRET

# [대시보드 주소] 메일 본문 링크 등에 사용
OOT_DASHBOARD_URL=http://localhost:8600

# [자동 알람 주기(분)]
OOT_ALARM_INTERVAL_MIN=10

# [메일 발송 계정(SMTP)]
QMS_SMTP_HOST=smtp.gmail.com
QMS_SMTP_PORT=587
QMS_SMTP_USER=your_account@example.com
QMS_SMTP_PASS=YOUR_APP_PASSWORD
QMS_ALERT_TO=receiver1@example.com,receiver2@example.com

# [알림 설정 진입 비밀번호] 초기값 131103 (비워두면 기본값). 화면에서 변경 가능.
# OOT_ALERT_PASSWORD=131103
