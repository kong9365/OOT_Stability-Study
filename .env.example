# Tableau 서버 설정
TABLEAU_SERVER=http://tableau.ekdp.com
TABLEAU_API_VERSION=3.21

# Tableau Personal Access Token (PAT)
# 주의: 토큰 이름은 Tableau에 등록된 정확한 이름이어야 합니다.
TABLEAU_PAT_NAME=OOS
TABLEAU_PAT_SECRET=여기에_PAT_암호_입력

# (선택) 이 API에 접근할 때 요구할 API Key
# 설정하면 요청 헤더 X-API-Key 또는 쿼리 파라미터 api_key 로 검증합니다.
# 비워두면 인증 없이 누구나 호출 가능합니다.
API_KEY=

# 서버 포트 (기본: 8000)
PORT=8000
